<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopLegacyMVC</RootNamespace>
    <AssemblyName>eShopLegacyMVC</AssemblyName>
    <!-- Assembly attributes are kept in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
    <!-- Pin transitive dependency of Microsoft.Data.SqlClient (9.0.11 has NU1902/NU1903 advisories) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\eShopLegacy.Utilities\eShopLegacy.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read at runtime relative to AppContext.BaseDirectory -->
    <None Update="log4Net.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Models\Infrastructure\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Seed data read from the content root by CatalogDBInitializer -->
    <None Update="Setup\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
