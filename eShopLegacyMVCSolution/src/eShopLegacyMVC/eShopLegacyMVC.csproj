<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopLegacyMVC</RootNamespace>
    <AssemblyName>eShopLegacyMVC</AssemblyName>
    <!-- Properties/AssemblyInfo.cs is kept (it also carries the log4net XmlConfigurator attribute). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pins the transitive Microsoft.Data.SqlClient dependency (9.0.11) past GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\eShopLegacy.Utilities\eShopLegacy.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read at runtime relative to AppContext.BaseDirectory -->
    <None Update="log4Net.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Models\Infrastructure\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Read at runtime relative to the content root (UseCustomizationData=true) -->
    <None Update="Setup\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
