<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopLegacyMVC</RootNamespace>
    <AssemblyName>eShopLegacyMVC</AssemblyName>
    <!-- AssemblyInfo.cs is kept in Properties/ -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pin patched version of transitive dependency (Microsoft.Data.SqlClient pulls 9.0.11: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\eShopLegacy.Utilities\eShopLegacy.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- log4net configuration, loaded from the application base directory at startup -->
    <None Update="log4Net.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- HiLo sequence scripts executed by CatalogDBInitializer from the application base directory -->
    <None Update="Models\Infrastructure\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Content-root data (not publicly served): catalog pictures and customization seed data -->
    <None Update="Pics\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Setup\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
