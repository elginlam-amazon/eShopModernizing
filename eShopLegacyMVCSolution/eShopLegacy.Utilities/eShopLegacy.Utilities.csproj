<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>eShopLegacy.Utilities</RootNamespace>
    <AssemblyName>eShopLegacy.Utilities</AssemblyName>
    <!-- Assembly attributes are kept in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <!-- System.Text.Json is inbox on net10.0; netstandard2.0 needs the package -->
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
</Project>
