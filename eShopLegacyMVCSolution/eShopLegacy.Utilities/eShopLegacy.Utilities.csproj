<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>eShopLegacy.Utilities</RootNamespace>
    <AssemblyName>eShopLegacy.Utilities</AssemblyName>
    <!-- Properties/AssemblyInfo.cs is kept, so the SDK must not generate a second set of assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <!-- System.Text.Json is in-box on net10.0; netstandard2.0 consumers need the package. -->
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
</Project>
